rules_version = '2';
// HMF Design Clinic — Firestore security rules.
// Paste into Firebase Console → Firestore → Rules → Publish.
// Reads are open (facilitated clinic); writes are shape-validated; client deletes
// are blocked. Delete a cohort's data from the console after the session.
service cloud.firestore {
  match /databases/{database}/documents {

    // Team registration: name + members
    match /teams/{id} {
      allow read: if true;
      allow create, update: if
        request.resource.data.teamName is string &&
        request.resource.data.teamName.size() < 120;
      allow delete: if false;
    }

    // Per-team, per-use-case answer sheets (shared auto-sync)
    match /answers/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.fields is map;
      allow delete: if false;
    }

    // Per-team scores + submission state (proctor reads these)
    match /scores/{id} {
      allow read: if true;
      allow create, update: if
        request.resource.data.teamName is string &&
        request.resource.data.total is number;
      allow delete: if false;
    }

    // Proctor-authored answer keys per use case
    match /answerkeys/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.text is string;
      allow delete: if false;
    }

    // Per-event config (model + AI on/off)
    match /config/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.model is string;
      allow delete: if false;
    }

    // Solution Grader (grader.html): proctor's uploaded answer sheet
    match /graderkey/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.text is string;
      allow delete: if false;
    }

    // Solution Grader: teams' uploaded worksheets + AI scores
    match /docscores/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.teamName is string;
      allow delete: if false;
    }

    // Standalone Team Scoring tool (tools/HMF-Scoring-Tool.html): shared leaderboard.
    // Kept separate from the app's collections. Reads stay open so the board renders;
    // writes and deletes require a signed-in identity (the tool signs in anonymously),
    // which blocks unauthenticated direct-API tampering. Enable Anonymous sign-in in
    // Firebase Auth for this to work; otherwise the tool falls back to an on-device board.
    match /leaderboard/{id} {
      allow read: if true;
      allow create, update: if request.auth != null &&
        request.resource.data.team is string &&
        request.resource.data.team.size() < 120 &&
        request.resource.data.total is number;
      allow delete: if request.auth != null;
    }
  }
}
